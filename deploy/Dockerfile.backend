# 后端服务镜像（FastAPI :8001）
FROM python:3.13-slim
WORKDIR /app

# 后端仅安装公共 + 后端依赖，不装 torch 等算法库，显著减小镜像体积
COPY requirements-base.txt requirements-backend.txt ./
# 国内构建加速：PyPI 走阿里云镜像
ENV PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    PIP_TRUSTED_HOST=mirrors.aliyun.com
RUN pip install --no-cache-dir -r requirements-base.txt -r requirements-backend.txt

COPY . .

EXPOSE 8001
# 启动前先做幂等的建表/种子数据初始化，避免全新数据卷导致 no such table
CMD ["sh", "-c", "python -m database.init_db && exec uvicorn backend.main:app --host 0.0.0.0 --port 8001"]