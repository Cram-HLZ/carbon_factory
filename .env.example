# ============================================================
# 碳排AI监测系统 - 环境变量配置模板
# 用法：复制本文件为 .env，再填入真实值即可（.env 已被 .gitignore 忽略）
# 注意：本文件为模板，请勿在此填入真实密钥/授权码/token
# ============================================================

# ---------- 认证密钥 ----------
# JWT 签名密钥（生产必须设置为强随机字符串，例如 openssl rand -hex 32）
AUTH_SECRET_KEY=

# ---------- 邮件 SMTP ----------
# 发件邮箱服务器地址，如 QQ 邮箱 smtp.qq.com / 163 smtp.163.com
SMTP_HOST=smtp.qq.com
# 端口：465 走 SSL（默认），587 走 STARTTLS（需同时设 SMTP_USE_SSL=0）
SMTP_PORT=465
# 1 = SSL（465），0 = STARTTLS（587）
SMTP_USE_SSL=1
# 发件邮箱账号
SMTP_USER=
# 授权码（非邮箱登录密码，需在邮箱设置里开启 SMTP 后生成）
SMTP_PASSWORD=
# 发件人显示地址（可留空，默认取 SMTP_USER）
SMTP_FROM=
# 收件人，多个用英文逗号分隔
SMTP_TO=

# ---------- 移动端推送（PushPlus / Server酱，选一个即可） ----------
# 推送类型：pushplus 或 serverchan
PUSH_TYPE=pushplus
# PushPlus token：登录 https://www.pushplus.plus 获取
PUSHPLUS_TOKEN=
# Server酱 SendKey：登录 https://sct.ftqq.com 获取
SERVERCHAN_KEY=

# ---------- DeepSeek AI 助手（OpenAI 兼容接口） ----------
# 不配置则 AI 助手自动降级为"未配置"提示，不影响其他功能
DEEPSEEK_API_KEY=
# 可选：自定义网关地址与模型
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
